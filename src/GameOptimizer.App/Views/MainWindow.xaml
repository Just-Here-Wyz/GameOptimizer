<Window x:Class="GameOptimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameOptimizer.App.ViewModels"
        xmlns:views="clr-namespace:GameOptimizer.App.Views"
        Title="游戏优化助手" Height="760" Width="1180"
        MinHeight="640" MinWidth="1000"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- 左侧导航项：选中时左侧亮条 + 背景高亮 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2C3038"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2E3646"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧分栏 -->
        <Border Grid.Column="0" Background="#FF16181D">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="游戏优化助手" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="20,22,20,18"/>

                <ListBox Grid.Row="1" x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectedIndex="0" SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="首页"/>
                    <ListBoxItem Content="数据"/>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="20,0,20,18">
                    <TextBlock Text="{Binding SamplerStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部栏：两页共用 -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="设备当前状态" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding HostSummary}" Style="{StaticResource Muted}" Margin="0,2,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="210">
                                <TextBlock Text="显存占用" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding VramText}" FontSize="17"/>
                            </StackPanel>
                            <StackPanel Width="230">
                                <TextBlock Text="内存" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding RamText}" FontSize="17"/>
                            </StackPanel>
                            <StackPanel Width="140">
                                <TextBlock Text="GPU 3D" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding GpuText}" FontSize="17"/>
                            </StackPanel>
                            <StackPanel Width="180">
                                <TextBlock Text="CPU" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding CpuText}" FontSize="17"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="{Binding GameModeButtonText}" Command="{Binding ToggleGameModeCommand}"
                                Background="{StaticResource Accent}" Margin="0,0,0,8" MinWidth="130"/>
                        <TextBlock Text="{Binding GameModeStatus}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" MaxWidth="250" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区：由左侧导航切换 -->
            <Grid Grid.Row="1" x:Name="PageHost">
                <!-- 首页 -->
                <Grid x:Name="HomePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding GameLibrarySummary}" VerticalAlignment="Center" FontSize="14"/>
                        <Button Content="重新扫描" Command="{Binding ScanGamesCommand}"
                                Margin="16,0,0,0" Padding="12,6"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VerdictText}"
                                                       Foreground="{Binding VerdictColor}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 数据页 -->
                <Grid x:Name="DataPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{Binding FrameCaptureButtonText}" Command="{Binding ToggleFrameCaptureCommand}"
                                Padding="12,6"/>
                        <Button Content="{Binding MonitorButtonText}" Command="{Binding ToggleMonitorCommand}"
                                Padding="12,6" Margin="10,0,0,0" Background="#FF3A3F4A"/>
                        <TextBlock Text="{Binding ChartSampleText}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- 帧时间状态：没接上时明确告知，不假装有数据 -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14"
                            Visibility="{Binding FrameTimeBannerVisibility}">
                        <TextBlock Text="{Binding FrameTimeStatus}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="帧时间 (ms) — 越低越好，越高说明卡顿" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <views:Sparkline Values="{Binding Charts.FrameMs}" Height="110" MinHeight="110"
                                                     LineBrush="#FFFF453A"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="显存占用 (MB)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <views:Sparkline Values="{Binding Charts.VramMb}" Height="100" MinHeight="100"
                                                     LineBrush="#FF4C8DFF"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="可用内存 (MB)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <views:Sparkline Values="{Binding Charts.RamMb}" Height="100" MinHeight="100"
                                                     LineBrush="#FF34C759"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="GPU 3D 利用率 (%)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <views:Sparkline Values="{Binding Charts.GpuPercent}" Height="100" MinHeight="100"
                                                     LineBrush="#FFFF9F0A"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="最高单核占用 (%)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <views:Sparkline Values="{Binding Charts.CpuCorePercent}" Height="100" MinHeight="100"
                                                     LineBrush="#FFBF5AF2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
