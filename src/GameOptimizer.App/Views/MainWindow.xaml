<Window x:Class="GameOptimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameOptimizer.App.Views"
        Title="游戏优化助手" Height="760" Width="1180"
        MinHeight="640" MinWidth="1000"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#FF0B0C0E"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- 无系统白框：去掉 WindowStyle 的标题栏，用 WindowChrome 保留拖动 / 缩放 / 贴边 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- bool → 可见性；null → 收起（图标兜底用） -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:NullToCollapsedInverseConverter x:Key="NullToCollapsedInverse"/>
        <!-- 空字符串 → 收起：未提权提示、优化结果有内容才占位 -->
        <views:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <!-- 百分比 → 星号列宽：条形图按比例分宽度（绑 Width 会变成像素） -->
        <views:PercentToStarConverter x:Key="PercentToStar"/>
        <!--
          左侧导航项：参考图没有左侧大栏，但工具本身靠它切页。
          这里把它压窄（72px）、去掉卡片感，做成图标 + 文字的紧凑竖排，
          视觉上更接近参考图的「顶栏 + 内容区」而不是传统的侧边管理台。
        -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FF83868D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1B1C21"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF23252C"/>
                                <Setter Property="Foreground" Value="#FFECEDEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- 1px 自绘描边：参考图四周有一圈极淡的轮廓，替代系统白框 -->
    <Border BorderBrush="#FF2A2C33" BorderThickness="1" Background="#FF0B0C0E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：整条可拖动，右侧三个按钮 -->
            <Grid Grid.Row="0" Background="#FF0B0C0E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 应用标识：参考图左上角是圆形图标 + 两行文字 -->
                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="#FF2A2C33"
                        Margin="16,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="优" FontSize="11" Foreground="#FFECEDEF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1" Text="游戏优化助手" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="#FFECEDEF"/>

                <!-- 顶部页签已移除（v1.0.1）：页面切换只保留左侧导航，
                     避免「左侧 + 右上角」两套切换入口重复 -->

                <!-- 窗口按钮：最小化 / 最大化 / 关闭（无系统白框） -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Minimize_Click" ToolTip="最小化">
                        <Rectangle Width="10" Height="1" Fill="#FFB4B7BD"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" x:Name="MaximizeButton"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Maximize_Click" ToolTip="最大化">
                        <Path x:Name="MaximizeGlyph" Width="10" Height="10" Stroke="#FFB4B7BD" StrokeThickness="1"
                              Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click" ToolTip="关闭">
                        <Path Width="10" Height="10" Stroke="#FFB4B7BD" StrokeThickness="1.2"
                              Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧窄导航 -->
                <Border Grid.Column="0" Background="#FF0E0F12" BorderBrush="#FF1E2024" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" x:Name="NavList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 SelectedIndex="0" SelectionChanged="NavList_SelectionChanged"
                                 Margin="0,10,0,0">
                            <ListBoxItem Content="总览"/>
                            <ListBoxItem Content="外设"/>
                            <!-- 下载（v2.2.0）：排在「设置」之上，样式与其余导航项完全共用 NavItem -->
                            <ListBoxItem Content="下载"/>
                            <ListBoxItem Content="设置"/>
                        </ListBox>

                        <TextBlock Grid.Row="1" Text="{Binding SamplerStatus}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="6,0,6,14"
                                   FontSize="10"/>
                    </Grid>
                </Border>

                <!-- 右侧页面 -->
                <Grid Grid.Column="1" Margin="0">
                    <!-- 总览页：进入 CPU 详情页时收起，两者共用同一区域 -->
                    <Grid x:Name="HomePage"
                          Visibility="{Binding IsOverviewVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 页头 -->
                        <Grid Grid.Row="0" Margin="24,20,24,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="总览" Style="{StaticResource H1}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameVramSummary}" Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="重新扫描" Command="{Binding ScanGamesCommand}"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
                            <StackPanel>
                                <!-- 四项占用仪表盘 -->
                                <Border Style="{StaticResource Card}" Padding="8,18,8,18">
                                    <StackPanel>
                                        <UniformGrid Columns="4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <views:PercentGauge Width="104" Height="104" Value="{Binding VramPercent}"/>
                                                <TextBlock Text="显存占用" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                                                <TextBlock Text="{Binding VramText}" Style="{StaticResource Faint}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 内存：v2.0.0 起仪表下方接「优化」按钮与三态结果 -->
                                            <StackPanel HorizontalAlignment="Center">
                                                <views:PercentGauge Width="104" Height="104" Value="{Binding RamPercent}"/>
                                                <TextBlock Text="内存占用" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                                                <TextBlock Text="{Binding RamText}" Style="{StaticResource Faint}"
                                                           HorizontalAlignment="Center"/>

                                                <Button Content="{Binding OptimizeButtonText}"
                                                        Command="{Binding OptimizeMemoryCommand}"
                                                        Background="{Binding OptimizeButtonHex}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="18,5" Margin="0,8,0,0"
                                                        HorizontalAlignment="Center"
                                                        ToolTip="把闲置内存置换到虚拟内存，不会结束任何进程"/>

                                                <TextBlock Text="{Binding MemoryOptimizeStatus}"
                                                           Foreground="{Binding MemoryOptimizeStatusHex}"
                                                           FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                                                           MaxWidth="150" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Center">
                                                <views:PercentGauge Width="104" Height="104" Value="{Binding GpuPercent}"/>
                                                <TextBlock Text="GPU 3D" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                                                <TextBlock Text="实时利用率" Style="{StaticResource Faint}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <!--
                                                  CPU 卡片：显示**整机总体占用率**（不是 P 核峰值），
                                                  点非按钮区域进 CPU 诊断页。
                                                  这里用 Border + MouseBinding 而不是「外层 Button 包住内层 Button」：
                                                  嵌套按钮时点「CPU 优化」会连带触发外层 Click，
                                                  一次点击跑两条流程（又跳诊断页又开优化）。两个控件是并列的，
                                                  事件互不牵连，MouseBinding 也不会收到已被内层控件处理掉的点击。
                                                -->
                                                <Border Background="Transparent" CornerRadius="10" Padding="6"
                                                        Cursor="Hand" ToolTip="点击查看 CPU 诊断">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding OpenCpuDetailCommand}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <views:PercentGauge Width="104" Height="104"
                                                                            Value="{Binding CpuLoadPercent}"
                                                                            ValueTextOverride="{Binding CpuGaugeText}"/>
                                                        <TextBlock Text="CPU 占用"
                                                                   HorizontalAlignment="Center" Margin="0,10,0,2"
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding CpuLoadText}"
                                                                   Style="{StaticResource Faint}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="查看诊断 →" FontSize="10"
                                                                   Foreground="#FF4C8DFF"
                                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Button Content="CPU 优化"
                                                        Command="{Binding OpenCpuOptimizeCommand}"
                                                        Padding="16,5" Margin="0,2,0,0"
                                                        HorizontalAlignment="Center"
                                                        ToolTip="检测高占用进程，确认后可结束；不修改优先级、亲和性与频率"/>
                                            </StackPanel>
                                        </UniformGrid>

                                        <!-- 未提权时的常驻提示：先说明再让用户点，别等点了才报错 -->
                                        <TextBlock Text="{Binding ElevationHint}"
                                                   Visibility="{Binding ElevationHint, Converter={StaticResource StringToVisibility}}"
                                                   Foreground="#FFFF9F0A" FontSize="11" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 游戏模式 -->
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="游戏模式" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding GameModeStatus}" Style="{StaticResource Muted}"
                                                       Foreground="{Binding GameModeStatusHex}"
                                                       TextWrapping="Wrap" Margin="0,4,16,0"/>
                                            <!--
                                              后台进程摘要：面板已挪进独立浮窗（v2.4），
                                              这里只保留一行结论，用户不必展开就知道自己保护了几个、会关几个。
                                            -->
                                            <TextBlock Text="{Binding BackgroundSummaryText}" Style="{StaticResource Faint}"
                                                       TextWrapping="Wrap" Margin="0,3,16,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="管理后台进程"
                                                Command="{Binding OpenBackgroundManagerCommand}"
                                                Margin="0,0,10,0" VerticalAlignment="Center"
                                                ToolTip="打开独立浮窗：搜索进程、勾选保护、标记结束目标"/>
                                        <Button Grid.Column="2" Content="{Binding GameModeButtonText}"
                                                Command="{Binding ToggleGameModeCommand}"
                                                Background="{Binding GameModeButtonHex}"
                                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                                MinWidth="104"
                                                ToolTip="开启时切换到高性能电源计划，并结束已标记为结束目标的后台进程；再点一次全部还原"/>
                                    </Grid>
                                </Border>

                                <!-- 游戏列表 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="已安装游戏" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding GameLibrarySummary}" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,10"/>
                                        <TextBlock Text="{Binding VramRemainingText}" Style="{StaticResource Faint}"
                                                   Margin="0,0,0,8"/>

                                        <ItemsControl ItemsSource="{Binding Games}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FF22242A" CornerRadius="8"
                                                            Padding="14,10" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="92"/>
                                                                <ColumnDefinition Width="96"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 游戏图标；扫描不到 exe 时退化为首字符色块 -->
                                                            <Border Grid.Column="0" Width="34" Height="34"
                                                                    CornerRadius="8" Background="#FF25272E"
                                                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <Grid>
                                                                    <Image Source="{Binding Icon}" Width="26" Height="26"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding IconFallbackText}" FontSize="13"
                                                                               Foreground="#FF83868D"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Visibility="{Binding Icon, Converter={StaticResource NullToCollapsedInverse}}"/>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource Muted}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding VerdictText}"
                                                                       Foreground="{Binding VerdictColor}"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       ToolTip="{Binding DemandText}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!--
                      CPU 页
                      从总览页点击 CPU 卡片进入，与总览页共用同一区域，不改左侧导航。
                      页内二级导航：CPU 诊断（默认）/ 高级详情。
                      三块内容共用第 1 行，可见性全部由 PageRouter 决定，任一时刻只有一块可见。
                    -->
                    <Grid x:Name="CpuDetailPage"
                          Visibility="{Binding IsCpuDetailVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 页头：返回 + 标题 + 二级导航 -->
                        <Grid Grid.Row="0" Margin="24,20,24,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="← 返回" Command="{Binding CloseCpuDetailCommand}"
                                    VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CPU" Style="{StaticResource H1}"/>
                                <TextBlock Text="{Binding CpuModelText}" Style="{StaticResource Faint}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="CPU 诊断" Command="{Binding ShowCpuDiagnosisCommand}"
                                        Background="{Binding CpuDiagnosisTabHex}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                <Button Content="高级详情" Command="{Binding ShowCpuAdvancedCommand}"
                                        Background="{Binding CpuAdvancedTabHex}"
                                        Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ============ 视图一：CPU 诊断（默认） ============ -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24"
                                      Visibility="{Binding IsCpuDiagnosisVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- 当前总体占用 + 负载状态 + 采样状态与数据完整性 -->
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <views:PercentGauge Grid.Column="0" Width="112" Height="112"
                                                            Value="{Binding CpuLoadPercent}"
                                                            ValueTextOverride="{Binding CpuGaugeText}"/>

                                        <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CpuReport.Headline}" FontSize="15"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{Binding CpuLevelHex}"/>
                                            <TextBlock Text="{Binding CpuReport.AverageText}"
                                                       Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding CpuReport.SamplingStatus}"
                                                       Style="{StaticResource Faint}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding CpuReport.CompletenessText}"
                                                       Style="{StaticResource Faint}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="CPU 优化"
                                                Command="{Binding OpenCpuOptimizeCommand}"
                                                Background="#FF4C8DFF"
                                                Style="{StaticResource PrimaryButton}"
                                                VerticalAlignment="Center"
                                                ToolTip="进入快速优化流程：先检测、再让你确认，最后回读验证"/>
                                    </Grid>
                                </Border>

                                <!-- 30 秒趋势：横轴按时间排布，漏采会留出空白 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="最近 30 秒总体负载" FontWeight="SemiBold" FontSize="14"/>
                                        <views:CpuTrendChart Height="120" Margin="0,10,0,0"
                                                             Points="{Binding CpuTrendPoints}"/>
                                        <TextBlock Text="虚线为 60% 关注线与 80% 高负载线；空白表示这段时间没有采到数据，不是 0%。"
                                                   Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 高占用进程：算不出来就说清楚为什么 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="高占用进程" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding CpuProcessStatus}" Style="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,3,0,8"/>

                                        <ItemsControl ItemsSource="{Binding CpuProcesses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="210"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                                                            <TextBlock Text="{Binding NameHint}"
                                                                       Style="{StaticResource Faint}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                                                   Foreground="{Binding ColorHex}"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                                   Foreground="{Binding StatusHex}"
                                                                   Style="{StaticResource Faint}"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding CpuProcessCaliber}" Style="{StaticResource Faint}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 诊断建议：每条都带依据 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="诊断建议" FontWeight="SemiBold" FontSize="14"/>
                                        <ItemsControl ItemsSource="{Binding CpuReport.Advices}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Muted}"
                                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ 视图二：快速优化流程 ============ -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24"
                                      Visibility="{Binding IsCpuOptimizeVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- 检测依据 + 状态行 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="CPU 快速优化" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{Binding CpuOptimizeBasis}" Style="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding CpuOptimizeSummary}" TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding CpuOptimizeStatus}"
                                                   Foreground="{Binding CpuOptimizeStatusHex}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding CpuOptimizeVerifyText}"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Visibility="{Binding CpuOptimizeVerifyText, Converter={StaticResource StringToVisibility}}"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding CpuOptimizeCaliberNote}"
                                                   Style="{StaticResource Faint}" TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 待确认的优化项：默认全部不勾选 -->
                                <Border Style="{StaticResource Card}"
                                        Visibility="{Binding HasCpuOptimizeAction, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="检测到的优化项（默认不勾选）" FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <ItemsControl ItemsSource="{Binding CpuOptimizeItems}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FF22242A" CornerRadius="8"
                                                            Padding="14,10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <CheckBox Content="{Binding Title}"
                                                                      IsChecked="{Binding Selected, Mode=TwoWay}"
                                                                      FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Evidence}"
                                                                       Style="{StaticResource Muted}"
                                                                       TextWrapping="Wrap" Margin="21,6,0,0"/>
                                                            <TextBlock Text="{Binding Impact}"
                                                                       Style="{StaticResource Faint}"
                                                                       TextWrapping="Wrap" Margin="21,4,0,0"/>
                                                            <TextBlock Text="{Binding RevertText}"
                                                                       Style="{StaticResource Faint}"
                                                                       TextWrapping="Wrap" Margin="21,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CpuOptimizeSelectionText}"
                                                       Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="返回诊断" Command="{Binding CloseCpuOptimizeCommand}"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="执行选中项"
                                                        Command="{Binding RunCpuOptimizeCommand}"
                                                        Background="#FF4C8DFF"
                                                        Style="{StaticResource PrimaryButton}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 回滚入口：只有真的结束过进程才出现 -->
                                <Border Style="{StaticResource Card}"
                                        Visibility="{Binding HasCpuOptimizeChanges, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="回滚" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="按原路径重新拉起被结束的进程。只保证「重新启动」，不保证恢复窗口、未保存内容与登录状态。"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                        <Button Content="恢复被结束的进程"
                                                Command="{Binding RevertCpuOptimizeCommand}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 检测附注：被排除的进程、口径限制、不做的事 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="检测附注" FontWeight="SemiBold" FontSize="14"/>
                                        <ItemsControl ItemsSource="{Binding CpuOptimizeNotes}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Faint}"
                                                               TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ 视图三：高级详情（原有逐核数据） ============ -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24"
                                      Visibility="{Binding IsCpuAdvancedVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- 结论：详情页最重要的一行，直接说要不要担心 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="结论" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding CpuDetail.VerdictText}" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 汇总：四个数字并排 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="汇总" FontWeight="SemiBold" FontSize="14"
                                                   Margin="0,0,0,10"/>
                                        <UniformGrid Columns="4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CpuDetail.PerformancePeakPercent, StringFormat={}{0:F0}%}"
                                                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="P 核峰值" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                <TextBlock Text="最高的一颗大核" Style="{StaticResource Faint}"
                                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="120"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CpuDetail.EfficiencyPeakPercent, StringFormat={}{0:F0}%}"
                                                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="E 核峰值" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                <TextBlock Text="最高的一颗小核" Style="{StaticResource Faint}"
                                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="120"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CpuDetail.GlobalPeakPercent, StringFormat={}{0:F0}%}"
                                                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="全局峰值" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                <TextBlock Text="全部核里最高的一个" Style="{StaticResource Faint}"
                                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="120"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <!-- 可空：总 CPU 读不到时显示「未知」，不是 0% -->
                                                <TextBlock Text="{Binding CpuDetail.TotalCpuText}"
                                                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="总 CPU" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                <TextBlock Text="全部核的平均" Style="{StaticResource Faint}"
                                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="120"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 硬件信息：型号 / 核心线程。型号读不到就写「未知」，不编占位文本 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="处理器" FontWeight="SemiBold" FontSize="14"
                                                   Margin="0,0,0,10"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CpuModelText}" FontSize="14"
                                                           FontWeight="SemiBold" TextAlignment="Center"
                                                           TextWrapping="Wrap" MaxWidth="360"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="型号" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CpuCoreCountText}" FontSize="20"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="核心 / 线程" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!--
                                  系统压力：从总览页搬进来（总 CPU 上面已有，这里不重复）。
                                  磁盘吞吐回答「贴图流式加载卡不卡在磁盘上」，与 CPU 同属整机指标，
                                  放在这里方便和 CPU 一起看。
                                -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="系统压力" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding PressureStatus}" Style="{StaticResource Faint}"
                                                   Margin="0,3,0,10" TextWrapping="Wrap"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DiskText}" FontSize="22" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="磁盘吞吐" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                <TextBlock Text="贴图流式加载是否卡在磁盘" Style="{StaticResource Faint}"
                                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="200"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CpuTopologyText}" FontSize="15" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           TextWrapping="Wrap" MaxWidth="240" VerticalAlignment="Center"/>
                                                <TextBlock Text="CPU 拓扑" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                <TextBlock Text="区分大小核的依据" Style="{StaticResource Faint}"
                                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="200"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 性能核组 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CpuDetail.PerformanceCore.Title}"
                                                   FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding CpuDetail.PerformanceCore.Subtitle}"
                                                   Style="{StaticResource Faint}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding CpuDetail.PerformanceCore.Bars}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3" Height="22">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="52"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat=逻辑核 {0}}"
                                                                   Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                                                        <!-- 两列按比例分宽度：左=占用，右=剩余。
                                                             百分比不能直接绑 Width（那是像素不是比例）。 -->
                                                        <Grid Grid.Column="1" VerticalAlignment="Center" Height="14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToStar}}"/>
                                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToStar}, ConverterParameter=inverse}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Background="{Binding ColorHex}"
                                                                    ToolTip="{Binding Percent, StringFormat={}{0:F1}%}"/>
                                                            <Border Grid.Column="1" CornerRadius="0,3,3,0" Background="#FF1B1C21"/>
                                                        </Grid>
                                                        <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0:F0}%}"
                                                                   Foreground="{Binding ColorHex}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 能效核组：无小核的机器上自动收起 -->
                                <Border Style="{StaticResource Card}"
                                        Visibility="{Binding CpuDetail.IsHybrid, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CpuDetail.EfficiencyCore.Title}"
                                                   FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding CpuDetail.EfficiencyCore.Subtitle}"
                                                   Style="{StaticResource Faint}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding CpuDetail.EfficiencyCore.Bars}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3" Height="22">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="52"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat=逻辑核 {0}}"
                                                                   Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                                                        <!-- 两列按比例分宽度：左=占用，右=剩余。
                                                             百分比不能直接绑 Width（那是像素不是比例）。 -->
                                                        <Grid Grid.Column="1" VerticalAlignment="Center" Height="14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToStar}}"/>
                                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToStar}, ConverterParameter=inverse}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Background="{Binding ColorHex}"
                                                                    ToolTip="{Binding Percent, StringFormat={}{0:F1}%}"/>
                                                            <Border Grid.Column="1" CornerRadius="0,3,3,0" Background="#FF1B1C21"/>
                                                        </Grid>
                                                        <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0:F0}%}"
                                                                   Foreground="{Binding ColorHex}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 外设页 -->
                    <Grid x:Name="PeripheralPage"
                          Visibility="{Binding IsPeripheralsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="24,20,24,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="外设" Style="{StaticResource H1}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PeripheralStatus}" Style="{StaticResource Faint}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="重新扫描" Command="{Binding ScanPeripheralsCommand}"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Peripherals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FF1B1C21" BorderBrush="{Binding ThemeHex}"
                                                    BorderThickness="1,1,1,3"
                                                    CornerRadius="12" Padding="16,14" Margin="0,0,14,14"
                                                    Width="310">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                                                Background="#FF25272E" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding KindText}" FontSize="10"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#FFB4B7BD"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                            <TextBlock Text="{Binding Model}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ManufacturerText}"
                                                                       Style="{StaticResource Faint}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" CornerRadius="5" Padding="7,2"
                                                                Background="#FF25272E" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding ConnectionText}" FontSize="10"
                                                                       Foreground="{Binding ConnectionAccentHex}"/>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <views:BatteryRing Grid.Column="0" Width="92" Height="92"
                                                                           Percent="{Binding BatteryPercent}"
                                                                           IsWired="{Binding IsWired}"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                    Margin="14,0,0,0">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding ThemeHex}"/>
                                                            <TextBlock Text="{Binding BatterySubText}"
                                                                       Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border BorderBrush="#FF26282E" BorderThickness="0,1,0,0"
                                                            Margin="0,12,0,0" Padding="0,8,0,0">
                                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Faint}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!--
                      下载页（v2.2.0）
                      导航项「下载」切过来。页面本身拆成独立的 DownloadPage 控件：
                      下载页比其余页面复杂（新建栏 + 分组列表 + 统计栏），
                      放进 MainWindow 会让这个已经 750 行的文件继续膨胀。
                      可见性仍由 PageRouter 绑定下来，不在这里写 Visibility。
                    -->
                    <Grid x:Name="DownloadPageHost"
                          Visibility="{Binding IsDownloadVisible, Converter={StaticResource BoolToVisibility}}">
                        <views:DownloadPage DataContext="{Binding Downloads}"/>
                    </Grid>

                    <!-- 设置页：目前只放版本与说明，保持三页导航结构完整 -->
                    <Grid x:Name="SettingsPage"
                          Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                            <StackPanel>
                                <TextBlock Text="设置" Style="{StaticResource H1}" Margin="0,0,0,16"/>

                                <!-- 使用说明书：界面各页不再挂说明文字，统一到这里查 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="使用说明书" FontWeight="SemiBold" FontSize="14"
                                                   Margin="0,0,0,12"/>

                                        <ItemsControl ItemsSource="{Binding ManualSections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,14" MaxWidth="820"
                                                                HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="版本" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="VersionText" Style="{StaticResource Faint}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="采集状态" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding SamplerStatus}" Style="{StaticResource Muted}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding VramBudgetText}" Style="{StaticResource Muted}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
