<Window x:Class="GameOptimizer.App.Views.BackgroundWhitelistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameOptimizer.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="后台进程保护" Height="730" Width="920"
        Icon="/app.ico"
        MinHeight="480" MinWidth="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF141519"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
      独立浮窗（v2.4）：总览页不再铺开整份进程列表，这里给足空间做搜索 / 筛选 / 详情。
      沿用主窗口的无系统白框做法（WindowStyle=None + WindowChrome），
      不用 AllowsTransparency —— 它会关掉硬件加速、让深色界面上的文字发虚。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:NullToCollapsedInverseConverter x:Key="NullToCollapsedInverse"/>
        <views:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility"/>

        <!-- 状态筛选标签：与左侧导航同一种「选中即浅一档底色」的做法 -->
        <Style x:Key="FilterItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FF83868D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF22242A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2C33"/>
                                <Setter Property="Foreground" Value="#FFECEDEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 详情里的只读路径框：可选可复制，但看起来不是输入框 -->
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFB4B7BD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="CaretBrush" Value="#FFECEDEF"/>
        </Style>

        <!--
          深色复选框：WPF 默认模板在近黑底上是一个亮白方块，非常刺眼。
          这里改成「1px 描边 + 选中后填充强调色 + 勾」，与卡片 / 按钮的圆角风格一致。
        -->
        <Style x:Key="ProtectCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFECEDEF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                                    Background="Transparent" BorderBrush="#FF4A4E58" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M2.5,6.5 L5.5,9.5 L10.5,3.5"
                                      Stroke="White" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF7C818C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF34C759"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF34C759"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF2A2C33" BorderThickness="1" Background="#FF141519">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：整条可拖动 -->
            <Grid Grid.Row="0" Background="#FF141519" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="#FF2A2C33"
                        Margin="16,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="护" FontSize="11" Foreground="#FFECEDEF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="后台进程保护" FontSize="13" FontWeight="SemiBold" Foreground="#FFECEDEF"/>
                    <TextBlock Text="勾选即保护" FontSize="11" Margin="10,1,0,0"
                               Foreground="#FF5C5F66"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource CloseButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click" ToolTip="关闭">
                    <Path Width="10" Height="10" Stroke="#FFB4B7BD" StrokeThickness="1.2"
                          Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
                </Button>
            </Grid>

            <!-- 工具栏：统计 + 搜索 + 筛选 -->
            <Border Grid.Row="1" Background="#FF1B1C21" BorderBrush="#FF26282E" BorderThickness="0,1,0,1"
                    Padding="16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="保护与结束" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding BackgroundCountText}" Style="{StaticResource Faint}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- 搜索框：占位符用「空字符串才显示」的转换器，不用水印属性 -->
                        <Border Grid.Column="1" Background="#FF22242A" CornerRadius="7"
                                Padding="10,5" Width="260" Margin="16,0,12,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid>
                                <TextBox Text="{Binding BackgroundSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         FontSize="12" Foreground="#FFECEDEF" CaretBrush="#FFECEDEF"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="搜索应用名、进程名或路径" FontSize="12"
                                           Foreground="#FF5C5F66" IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding BackgroundSearchText, Converter={StaticResource EmptyToVisibility}}"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="全部保护" Command="{Binding ProtectAllBackgroundCommand}" Margin="0,0,6,0"
                                    ToolTip="把当前列出的进程全部勾选为受保护：本次一个都不会被结束"/>
                            <Button Content="取消保护" Command="{Binding UnprotectAllBackgroundCommand}"
                                    ToolTip="取消全部保护勾选。只改状态，不会结束任何进程；下次启动游戏模式时它们会被结束"/>
                        </StackPanel>
                    </Grid>

                    <!-- 状态筛选 -->
                    <ListBox ItemsSource="{Binding BackgroundFilters}"
                             SelectedItem="{Binding SelectedBackgroundFilter, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FilterItem}"
                             Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--
                      旧配置迁移提示：必须看得见。旧版「勾选 = 会结束」的语义按原样保留为结束目标，
                      不会静默倒成「受保护」——否则用户会以为游戏模式还在关那些程序。
                    -->
                    <Border Background="#1AFF9F0A" BorderBrush="#66FF9F0A" BorderThickness="1"
                            CornerRadius="7" Padding="10,7" Margin="0,10,0,0"
                            Visibility="{Binding HasBackgroundNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BackgroundNoticeText}" TextWrapping="Wrap"
                                   Foreground="#FFFFBF5A" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 进程列表 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="16,12,16,4">
                <ItemsControl ItemsSource="{Binding BackgroundProcessesView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF1B1C21" BorderBrush="#FF26282E" BorderThickness="1"
                                    CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 应用图标；读不到时退化成首字符色块 -->
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                Background="#FF25272E" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="26" Height="26"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding IconFallbackText}" FontSize="13"
                                                           Foreground="#FF83868D"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding Icon, Converter={StaticResource NullToCollapsedInverse}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AppName}" FontSize="13" FontWeight="SemiBold"/>
                                                <Border BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="{Binding StateHex}">
                                                    <TextBlock Text="{Binding StateText}" FontSize="10"
                                                               Foreground="{Binding StateHex}"/>
                                                </Border>
                                                <TextBlock Text="运行中" FontSize="10" Margin="8,1,0,0"
                                                           Foreground="#FF5C5F66" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding ProcessNameText}" Style="{StaticResource Faint}"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding PublisherText}" Style="{StaticResource Faint}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- 用途说明：识别不出来就写「用途未知」，不编造 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="用途：" FontSize="11" Foreground="#FF5C5F66"/>
                                                <TextBlock Text="{Binding Purpose}" FontSize="11"
                                                           Foreground="{Binding PurposeHex}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 勾选 = 保护（本次改造的核心语义） -->
                                        <CheckBox Grid.Column="2" Content="保护"
                                                  Style="{StaticResource ProtectCheckBox}"
                                                  IsChecked="{Binding IsProtected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  ToolTip="勾选后，游戏模式绝不会结束这个进程；不勾的默认会被结束"/>

                                        <!-- 结果只读展示：未勾保护且通过安全检查 = 会结束 -->
                                        <Border Grid.Column="3" BorderThickness="1" CornerRadius="4"
                                                Padding="7,2" VerticalAlignment="Center" Margin="0,0,8,0"
                                                BorderBrush="{Binding KillBadgeHex}">
                                            <TextBlock Text="{Binding KillBadgeText}" FontSize="10"
                                                       Foreground="{Binding KillBadgeHex}"/>
                                        </Border>

                                        <Button Grid.Column="4" Content="详情" Padding="10,5"
                                                VerticalAlignment="Center"
                                                Click="ToggleDetail_Click"
                                                ToolTip="展开查看完整路径、文件描述与识别依据"/>
                                    </Grid>

                                    <!-- 展开的详细信息 -->
                                    <Border Background="#FF15161A" CornerRadius="8" Padding="10" Margin="44,10,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="完整路径" Style="{StaticResource Faint}"/>
                                            <TextBox Text="{Binding PathText, Mode=OneWay}" Style="{StaticResource PathBox}"
                                                     Margin="0,2,0,8"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="文件描述" Style="{StaticResource Faint}"/>
                                                    <TextBlock Text="{Binding FileDescription, TargetNullValue=—}"
                                                               Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="产品名称 / 版本" Style="{StaticResource Faint}"/>
                                                    <TextBlock Text="{Binding ProductName, TargetNullValue=—}"
                                                               Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding FileVersion, TargetNullValue=—}"
                                                               Style="{StaticResource Faint}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="识别依据" Style="{StaticResource Faint}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding PurposeBasis}" Style="{StaticResource Muted}"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="判定" Style="{StaticResource Faint}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding DecisionText}" Style="{StaticResource Muted}"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding SystemReason}" Style="{StaticResource Muted}"
                                                       Foreground="#FFFF9F0A" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding SystemReason, Converter={StaticResource StringToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部：结论 + 保存状态 + 路径 -->
            <Border Grid.Row="3" Background="#FF1B1C21" BorderBrush="#FF26282E" BorderThickness="0,1,0,0"
                    Padding="16,10,16,12">
                <StackPanel>
                    <TextBlock Text="{Binding BackgroundKillPreviewText}" TextWrapping="Wrap"
                               FontSize="11" Foreground="#FF83868D"/>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BackgroundStatusText}" FontSize="11"
                                       Foreground="{Binding BackgroundStatusHex}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding BackgroundConfigPath}" Style="{StaticResource Faint}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding BackgroundConfigPath}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="重新扫描" Command="{Binding RescanBackgroundCommand}" Margin="0,0,6,0"
                                    ToolTip="重新读取当前运行的后台进程与磁盘上的配置"/>
                            <Button Content="保存" Command="{Binding SaveBackgroundListCommand}" Margin="0,0,6,0"
                                    ToolTip="立即写盘；改动本身已即时保存，这里用于保存失败后重试"/>
                            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Click="Close_Click"
                                    ToolTip="只关闭本窗口，不会开启游戏模式、也不会结束任何进程"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="勾选「保护」= 绝不结束；没勾的默认会被结束。系统关键进程、游戏本体、读不到路径的进程即使没勾也不会被结束，而且只有启动游戏模式时才会执行。"
                               Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
