<UserControl x:Class="GameOptimizer.App.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GameOptimizer.App.Views"
             FontFamily="Microsoft YaHei UI"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!--
          本页自带的三个转换器。
          **不能**引用 MainWindow.Resources 里的同名资源：UserControl 是独立的 XAML 作用域，
          解析时看不到父窗口的资源，运行时会抛 XamlParseException
          （离屏渲染验收时就是这么发现「主窗口一构造就崩」的）。
        -->
        <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility"/>
        <views:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
          下载页（v2.2.0）。
          参考 PCL2 的下载器交互：顶部一条新建任务栏，中间按状态分组的任务卡片，底部一条全局统计。
          视觉全部复用 App.xaml 的全局资源（Card / H1 / Muted / Faint / PrimaryButton / 滚动条），
          这里只新增「任务卡片」和「进度条」两个本页专用样式，不改动任何全局样式。
        -->

        <!-- 输入框：全局没有 TextBox 样式，这里按卡片同色系补一个，避免系统白底 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF141519"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条：细横条 + 圆角，颜色跟随任务状态 -->
        <Style x:Key="TaskProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#FF23252C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <!-- PART_Indicator 由 ProgressBar 自己按 Value 改宽度 -->
                            <Border x:Name="PART_Track" CornerRadius="3" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组标题：一个序号色块 + 名称，视觉上比纯文字更容易扫读 -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!--
          任务卡片。宽度随窗口拉伸（不是固定 310 的外设卡片）：
          下载任务的信息比外设多（速度 / 剩余 / 校验），横排才放得下。
        -->
        <DataTemplate x:Key="TaskCard">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                <StackPanel>
                    <!-- 第一行：文件名 + 状态标签 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FilePath}"/>
                            <TextBlock Text="{Binding DirectoryText}" Style="{StaticResource Faint}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="5" Padding="8,2" VerticalAlignment="Top"
                                Background="#FF23252C" Margin="10,0,0,0">
                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                       Foreground="{Binding StatusColor}"/>
                        </Border>
                    </Grid>

                    <!-- 第二行：进度条 -->
                    <Grid Margin="0,10,0,0">
                        <ProgressBar Style="{StaticResource TaskProgress}"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     Foreground="{Binding StatusColor}"/>
                    </Grid>

                    <!-- 第三行：大小 / 速度 / 剩余时间 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" Style="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Style="{StaticResource Muted}"
                                   Foreground="{StaticResource Accent}" Margin="12,0,0,0"/>

                        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" Style="{StaticResource Muted}"
                                   Margin="12,0,0,0"/>

                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Faint}"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <!-- 失败原因：只在有内容时出现，卡片上必须看得见 -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFF453A" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>

                    <!-- 校验结论：下载完成后才出现 -->
                    <TextBlock Text="{Binding ChecksumText}" Style="{StaticResource Faint}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding PrimaryActionText}"
                                Command="{Binding PrimaryCommand}"
                                Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,6,0"/>

                        <Button Content="取消" Command="{Binding CancelCommand}"
                                Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,6,0"/>

                        <Button Content="重新下载" Command="{Binding RestartCommand}" Margin="0,0,6,0"/>

                        <Button Content="校验" Command="{Binding VerifyCommand}"
                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,6,0"/>

                        <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0"/>

                        <Button Content="移除记录" Command="{Binding RemoveCommand}"
                                Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 页头 -->
            <RowDefinition Height="Auto"/>   <!-- 新建任务栏 -->
            <RowDefinition Height="*"/>      <!-- 任务列表 -->
            <RowDefinition Height="Auto"/>   <!-- 全局统计 -->
        </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <Grid Grid.Row="0" Margin="24,20,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="下载" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                           Text="粘贴直链即可多线程下载；支持断点续传、完成校验与失败重试"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="全部暂停" Command="{Binding PauseAllCommand}" Margin="0,0,6,0"/>
                <Button Content="全部开始" Command="{Binding ResumeAllCommand}" Margin="0,0,6,0"/>
                <Button Content="清空已完成" Command="{Binding ClearCompletedCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===== 新建任务栏 ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,0,24,10" Padding="14">
            <StackPanel>
                <!-- 地址一行：占宽 60%，右侧跟主按钮 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="10,7,10,7"/>
                        <TextBlock Text="请输入文件下载直链，粘贴自动识别文件名"
                                   IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Style="{StaticResource Faint}"
                                   Visibility="{Binding Url, Converter={StaticResource EmptyToVisibility}}"/>
                    </Grid>

                    <TextBox Grid.Column="1" Margin="0,0,10,0"
                             Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="全局限速，例如 10MB 或 500KB；留「不限速」表示不限制"/>

                    <Button Grid.Column="2" Content="添加下载"
                            Command="{Binding AddTaskCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="18,7"/>
                </Grid>

                <!-- 路径与文件名一行 -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding SaveDirectory}"/>

                    <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseDirectoryCommand}"
                            Margin="8,0,10,0"/>

                    <TextBox Grid.Column="2" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="默认从链接自动提取，可手动修改"/>
                </Grid>

                <!-- 次要设置与即时反馈 -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="并发分片" Style="{StaticResource Faint}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Width="52" Margin="6,0,0,0"
                             Text="{Binding SegmentText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="单个任务的分片并发数，1~16，默认 4"/>
                    <Button Grid.Column="2" Content="应用" Margin="6,0,0,0" Command="{Binding ApplySegmentsCommand}"/>
                    <Button Grid.Column="3" Content="应用限速" Margin="10,0,0,0"
                            Command="{Binding ApplySpeedLimitCommand}"/>

                    <TextBlock Grid.Column="4" Text="{Binding NewTaskStatus}"
                               Foreground="{Binding NewTaskStatusHex}" FontSize="11"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding NewTaskStatus, Converter={StaticResource StringToVisibility}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== 任务列表 ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,12">
            <StackPanel>
                <!-- 空状态 -->
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="10" Padding="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="还没有下载任务" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="在上面的地址栏粘贴直链，选好保存位置后点「添加下载」。&#10;任务会保存在本地，程序重启后自动接上未完成的进度。"/>
                    </StackPanel>
                </Border>

                <!-- 正在下载 -->
                <StackPanel Visibility="{Binding HasActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ActiveHeader}" Style="{StaticResource GroupHeader}"/>
                    <ItemsControl ItemsSource="{Binding Active}" ItemTemplate="{StaticResource TaskCard}"/>
                </StackPanel>

                <!-- 下载失败（含已暂停 / 已取消，都需要用户处理） -->
                <StackPanel Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,10,0,0">
                    <TextBlock Text="{Binding FailedHeader}" Style="{StaticResource GroupHeader}"/>
                    <ItemsControl ItemsSource="{Binding Failed}" ItemTemplate="{StaticResource TaskCard}"/>
                </StackPanel>

                <!-- 已完成 -->
                <StackPanel Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,10,0,0">
                    <TextBlock Text="{Binding CompletedHeader}" Style="{StaticResource GroupHeader}"/>
                    <ItemsControl ItemsSource="{Binding Completed}" ItemTemplate="{StaticResource TaskCard}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 全局统计栏 ===== -->
        <Border Grid.Row="3" Background="#FF141519" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Text="总速度"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalSpeedText}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="8,0,0,0"
                           MinWidth="96"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <TextBlock Text="{Binding RunningText}" Style="{StaticResource Muted}"/>
                    <TextBlock Text=" · " Style="{StaticResource Faint}"/>
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource Muted}"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Style="{StaticResource Faint}" VerticalAlignment="Center"
                           Text="已完成文件自动计算 SHA1；服务端提供校验值时逐字节比对"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
