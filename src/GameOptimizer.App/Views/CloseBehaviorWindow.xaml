<Window x:Class="GameOptimizer.App.Views.CloseBehaviorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关闭行为设置" Height="360" Width="520"
        Icon="/app.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF141519"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
      关闭行为选择弹窗。
      沿用项目里「无系统白框」的做法（WindowStyle=None + WindowChrome），
      不用 AllowsTransparency：它会关掉硬件加速，深色界面上的小字会发虚。

      两个选项用 RadioButton 而不是自绘 ToggleButton：
      键盘方向键切换、Tab 聚焦、读屏念出「单选项」都是控件自带的，自绘得一件件补。

      选中状态刻意做了三重表达：左侧单选圆点填实、卡片描边变蓝、右侧出现「已选」。
      只靠卡片底色的话深色主题下几乎看不出来（需求里也明确要求不能只靠颜色）。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 单选选项卡：整张卡片可点，内容由使用处放进 Content -->
        <Style x:Key="BehaviorOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFECEDEF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="10" Padding="14,12"
                                Background="#FF1B1C21" BorderBrush="#FF26282E" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 单选圆点：未选是灰圈空心，选中是蓝圈 + 蓝实心点 -->
                                <Grid Grid.Column="0" Width="18" Height="18"
                                      VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse x:Name="Ring" Stroke="#FF5C5F66" StrokeThickness="1.4"
                                             Fill="Transparent"/>
                                    <Ellipse x:Name="Dot" Width="8" Height="8"
                                             Fill="#FF4C8DFF" Visibility="Collapsed"/>
                                </Grid>

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>

                                <TextBlock x:Name="Chosen" Grid.Column="2" Text="已选"
                                           FontSize="11" Foreground="#FF4C8DFF"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FF3A3E48"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF1E2431"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FF4C8DFF"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#FF4C8DFF"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Chosen" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色复选框：选中用强调蓝填充，与主按钮同色系 -->
        <Style x:Key="PromptCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFECEDEF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="Transparent" BorderBrush="#FF4A4E58" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M2.5,6.5 L5.5,9.5 L10.5,3.5"
                                      Stroke="White" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF7C818C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF4C8DFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF4C8DFF"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF2A2C33" BorderThickness="1" Background="#FF141519">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：整条可拖动 -->
            <Grid Grid.Row="0" Background="#FF141519" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="#FF2A2C33"
                        Margin="16,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="关" FontSize="11" Foreground="#FFECEDEF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="关闭行为设置" FontSize="13" FontWeight="SemiBold" Foreground="#FFECEDEF"/>
                    <TextBlock Text="游戏优化助手" FontSize="11" Margin="10,1,0,0" Foreground="#FF5C5F66"/>
                </StackPanel>

                <!-- 右上角 ×：与「取消」等价，不保存、不隐藏、不退出 -->
                <Button Grid.Column="2" Style="{StaticResource CloseButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding CancelCommand}" ToolTip="关闭（本次不做任何改变）">
                    <Path Width="10" Height="10" Stroke="#FFB4B7BD" StrokeThickness="1.2"
                          Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
                </Button>
            </Grid>

            <!-- 正文 -->
            <StackPanel Grid.Row="1" Margin="20,4,20,0">
                <TextBlock Text="你希望如何处理程序？" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFECEDEF"/>
                <TextBlock Text="选一项并点「确认」才会生效；点「取消」则主窗口原样留着。"
                           FontSize="11" Foreground="#FF83868D" Margin="0,5,0,14" TextWrapping="Wrap"/>

                <RadioButton x:Name="MinimizeOption" Style="{StaticResource BehaviorOption}"
                             GroupName="CloseBehaviorOptions"
                             IsChecked="{Binding IsMinimizeSelected, Mode=TwoWay}"
                             Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="缩小到系统托盘" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFECEDEF"/>
                        <TextBlock Text="隐藏主窗口，程序继续在后台运行，双击托盘图标可再打开"
                                   FontSize="11" Foreground="#FF83868D" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ExitOption" Style="{StaticResource BehaviorOption}"
                             GroupName="CloseBehaviorOptions"
                             IsChecked="{Binding IsExitSelected, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="退出程序" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFECEDEF"/>
                        <TextBlock Text="结束程序，退出前会先还原游戏模式做过的改动（电源计划、后台进程）"
                                   FontSize="11" Foreground="#FF83868D" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>

                <CheckBox x:Name="RememberCheck" Style="{StaticResource PromptCheckBox}"
                          IsChecked="{Binding Remember, Mode=TwoWay}" Margin="2,16,0,0"
                          Content="记住我的选择，下次不再提示"/>
                <TextBlock Text="{Binding RememberHint}" FontSize="11" Foreground="#FF5C5F66"
                           Margin="24,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="#FF1B1C21" BorderBrush="#FF26282E" BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="关闭行为保存在本机，可随时在设置页修改"
                               FontSize="11" Foreground="#FF5C5F66" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="72"
                                ToolTip="关闭本窗口：主窗口保持显示，什么都不改"/>
                        <Button Content="确认" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmCommand}" MinWidth="88"
                                ToolTip="按当前选择处理窗口"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
